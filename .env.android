# Public OTA configuration of the Android build (vite --mode android). Nothing here is secret: public keys,
# exact hosts and the manifest URL of the "stable" channel. Private keys live outside the repository.
# Process environment variables win over this file (the "Salud Dev" builds set their own).
VITE_OTA_ENABLED=1
VITE_OTA_PUBLIC_KEYS='{"k2026a":{"kty":"EC","crv":"P-256","x":"A8lKQPAJmzxJEsRhgnqino50ycdS7-Cq0CmHV-2l4e8","y":"b7CZzccEQLHR253qiTdG0ag0Dir3JJde4xCYP1GE3KU"},"k2026b":{"kty":"EC","crv":"P-256","x":"vtEq3sQ9FACMdb09A8gjg1zCr1srJHQmYa06JzA1660","y":"bGZv-KRlnOgRc3UJRr3wz4lPLBhq9ItNlFXxMqgrjnE"}}'
VITE_OTA_ALLOWED_HOSTS='["github.com","release-assets.githubusercontent.com"]'
VITE_OTA_MANIFEST_URL=https://github.com/hshsmartin1-code/salud/releases/download/ota-stable/manifest.json
VITE_OTA_CHANNEL=stable
VITE_DISTRIBUTION=sideload
