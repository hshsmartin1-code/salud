{
  "name": "app",
  "private": true,
  "version": "3.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build:android": "tsc -b && node scripts/copy-ocr-assets.mjs && vite build --mode android && cap sync android",
    "android:apk": "node scripts/check-distributable.mjs && node scripts/android-apk.mjs",
    "test:emulator": "npx --yes firebase-tools@15.34.2 emulators:exec --only auth,firestore --project demo-salud \"vitest run --config vitest.emulator.config.ts\"",
    "dev:emulator": "npx --yes firebase-tools@15.34.2 emulators:exec --only auth,firestore --project demo-salud \"vite --mode emulator --port 4190 --strictPort\"",
    "test:e2e:emulator": "npx --yes firebase-tools@15.34.2 emulators:exec --only auth,firestore --project demo-salud \"playwright test -c playwright.emulator.config.ts\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-updater": "^8.54.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
